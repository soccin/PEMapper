#!/bin/bash

SDIR="$( cd "$( dirname "$0" )" && pwd )"

PICARDJAR=$SDIR/jar/picard.jar

COMMAND=$1
shift 1

if [ "$COMMAND" == "" ]; then
    $JAVA -jar $PICARDJAR 2>&1 | less -R
    exit
fi

#
# picard spills its sort to TMP_DIR; /localscratch is node local disk on
# IRIS. /fscratch and /scratch/socci, the old JUNO paths, are both gone.
#
TDIR=${PEMAP_TMPDIR:-/localscratch/$USER}
mkdir -p $TDIR 2>/dev/null

if [ ! -d "$TDIR" ]; then
    TDIR=${TMPDIR:-/tmp}
    echo "WARNING: cannot make picard TMP_DIR, falling back to $TDIR"
fi


java -Xmx23g -Djava.io.tmpdir=$TDIR \
    -jar $PICARDJAR $COMMAND TMP_DIR=$TDIR VALIDATION_STRINGENCY=SILENT $*


