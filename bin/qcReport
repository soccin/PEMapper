#!/bin/bash

#
# qcReport -- one HTML QC report from the picard metrics PEMapper
# writes, for every sample under one or more output directories.
#
# usage:
#   qcReport [-o REPORT.html] [-t TITLE] DIR [DIR ...]
#
#   qcReport out___M                    writes ./qcReport.html
#   qcReport -o Proj_QC.html out___M out___M__NoClip
#
# Each DIR is searched at any depth for <S>___AS.txt, <S>___MD.txt,
# <S>___INS.txt and RUNSTATUS.txt. The report is a single file with
# plotly.js embedded, so it opens offline and can be sent as is.
#
# The work is done by qcReport.py with the python in bin/venv, which is
# where plotly is installed (bin/mkVenv). An existing venv made before
# plotly was added there needs it once:
#
#   bin/venv/bin/pip install plotly
#
# Reads only small text files; fine to run on a login node.
#

SDIR="$( cd "$( dirname "$0" )" && pwd )"

if [ ! -x "$SDIR/venv/bin/python3" ]; then
    echo -e "\n   Need to install venv"
    echo -e "   Run \`mkVenv\` in bin folder\n"
    exit 1
fi

#
# exec, so the exit status is qcReport.py's own.
#
exec "$SDIR/venv/bin/python3" "$SDIR/qcReport.py" "$@"
